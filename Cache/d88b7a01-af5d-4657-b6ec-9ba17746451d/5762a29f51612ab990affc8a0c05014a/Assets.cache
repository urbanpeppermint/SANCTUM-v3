    - '// @input float _minHeight {"label":"Min Height", "hint":"Minimum height (0 = no minimum)."}'
    - '// @input float _maxHeight {"label":"Max Height", "hint":"Maximum height (0 = no maximum)."}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Dropdown Cell</span>"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #94A3B8; font-size: 11px;\">Wrapper-specific options for items inside a Dropdown</span>"}'
    - '// @input bool _stretchToFill = true {"hint":"When true, stretches the element to fill the cell (flexGrow=1). When false, the element keeps its own size."}'
    - '// @input string _alignment = "Left" {"hint":"Alignment of the element within the cell when stretchToFill is off.", "widget":"combobox", "values":[{"label":"Left", "value":"Left"}, {"label":"Center", "value":"Center"}, {"label":"Right", "value":"Right"}], "showIf":"_stretchToFill", "showIfValue":false}'
