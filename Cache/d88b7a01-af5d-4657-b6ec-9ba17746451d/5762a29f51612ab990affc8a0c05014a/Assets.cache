    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Container Size</span>"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #94A3B8; font-size: 11px;\">Dimensions of the flex container in local space</span>"}'
    - '// @input float _width = 20 {"label":"Width", "hint":"Container width in cm. -1 = auto (shrink-to-fit content)."}'
    - '// @input float _height = 20 {"label":"Height", "hint":"Container height in cm. -1 = auto (shrink-to-fit content)."}'
