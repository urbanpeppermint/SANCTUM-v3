    - '// @input float _paddingRight {"label":"Right", "hint":"Right padding in cm."}'
    - '// @input float _paddingBottom {"label":"Bottom", "hint":"Bottom padding in cm."}'
    - '// @input float _paddingLeft {"label":"Left", "hint":"Left padding in cm."}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Alignment</span>"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #94A3B8; font-size: 11px;\">Default alignment for all items within their grid cells</span>"}'
    - '// @input string _justifyItems = "stretch" {"label":"Justify Items", "hint":"Default horizontal alignment for all items in their cells.", "widget":"combobox", "values":[{"label":"Start", "value":"start"}, {"label":"Center", "value":"center"}, {"label":"End", "value":"end"}, {"label":"Stretch", "value":"stretch"}]}'
    - '// @input string _alignItems = "stretch" {"label":"Align Items", "hint":"Default vertical alignment for all items in their cells.", "widget":"combobox", "values":[{"label":"Start", "value":"start"}, {"label":"Center", "value":"center"}, {"label":"End", "value":"end"}, {"label":"Stretch", "value":"stretch"}]}'
