    - "// @input string _templateAreas {\"label\":\"Template Areas\", \"hint\":\"Named grid areas. Rows separated by '/'. E.g. 'header header / sidebar content / footer footer'\", \"widget\":\"text_area\"}"
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Auto Flow</span>"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #94A3B8; font-size: 11px;\">How auto-placed items fill empty grid cells</span>"}'
    - '// @input string _autoFlow = "row" {"label":"Auto Flow", "hint":"How auto-placed items fill the grid.", "widget":"combobox", "values":[{"label":"Row", "value":"row"}, {"label":"Column", "value":"column"}, {"label":"Row Dense", "value":"rowDense"}, {"label":"Column Dense", "value":"columnDense"}]}'
    - '// @ui {"widget":"separator"}'
