    - '// @input string _horizontalAlignment = "center" {"label":"Horizontal", "hint":"Horizontal alignment of the grid content relative to the SceneObject center.", "widget":"combobox", "values":[{"label":"Left", "value":"left"}, {"label":"Center", "value":"center"}, {"label":"Right", "value":"right"}]}'
    - '// @input string _verticalAlignment = "center" {"label":"Vertical", "hint":"Vertical alignment of the grid content relative to the SceneObject center.", "widget":"combobox", "values":[{"label":"Top", "value":"top"}, {"label":"Center", "value":"center"}, {"label":"Bottom", "value":"bottom"}]}'
