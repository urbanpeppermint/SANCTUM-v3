    - '// @input Asset.Font _fontFamily {"hint":"Font Family"}'
    - '// @input string _placeholderText {"hint":"Text that is displayed before any text is entered"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Event Callbacks</span>"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #94A3B8; font-size: 11px;\">Optional script functions to trigger on component events</span>"}'
    - "// @input bool addCallbacks {\"hint\":\"Enable this to add functions from another script to this component's callbacks\"}"
    - /*
    - "@typedef Callback"
    - "@property {Component.ScriptComponent} scriptComponent"
    - "@property {string} functionName"
    - "*/"
    - '// @input Callback[] onTextChangedCallbacks = {} {"label":"On Text Changed Callbacks", "showIf":"addCallbacks"}'
    - '// @input Callback[] onKeyboardStateChangedCallbacks = {} {"label":"On Keyboard State Changed Callbacks", "showIf":"addCallbacks"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Alignment</span>"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #94A3B8; font-size: 11px;\">Horizontal text alignment</span>"}'
    - '// @input string _horizontalTextAlignment = "left" {"hint":"Alignment of the text within the text field.", "widget":"combobox", "values":[{"label":"Left", "value":"left"}, {"label":"Right", "value":"right"}]}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Input Type</span>"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #94A3B8; font-size: 11px;\">Validation and keyboard behavior</span>"}'
    - '// @input string inputType = "default" {"widget":"combobox", "values":[{"label":"Default", "value":"default"}, {"label":"Numeric", "value":"numeric"}, {"label":"Password", "value":"password"}, {"label":"Pin", "value":"pin"}, {"label":"URL", "value":"url"}]}'
    - '// @input bool contentRequiredOnDeactivate {"hint":"Throw error if unfocused with no input"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Action Slot</span>"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #94A3B8; font-size: 11px;\">Action slot follows horizontal text alignment. `password` input type overrides this with an eye-icon toggle.</span>"}'
    - '// @input string _actionSlot = "voiceInput" {"widget":"combobox", "values":[{"label":"None", "value":"none"}, {"label":"Voice Input", "value":"voiceInput"}, {"label":"Icon Change", "value":"iconChange"}]}'
    - '// @input Asset.Texture icon {"hint":"Icon Texture", "showIf":"_actionSlot", "showIfValue":"iconChange"}'
    - '// @input bool changeIconOnFocus {"hint":"Switch to a different icon on focus", "showIf":"_actionSlot", "showIfValue":"iconChange"}'
    - '// @input Asset.Texture alternateIcon {"hint":"Alternate icon used on focus", "showIf":"changeIconOnFocus", "showIfValue":true}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Clear Button</span>"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #94A3B8; font-size: 11px;\">Show a clear button when text has been entered</span>"}'
    - '// @input bool _showClearButton = true {"label":"Show Clear Button", "hint":"Show a clear button when text has been entered"}'
