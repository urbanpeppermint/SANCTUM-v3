  InputLines:
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Flex Properties</span>"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #94A3B8; font-size: 11px;\">Controls how this item grows, shrinks, and aligns within the flex container</span>"}'
    - '// @input int _order {"label":"Order", "hint":"Visual reordering without changing hierarchy. Lower values appear first."}'
    - "// @input float _flexGrow {\"label\":\"Flex Grow\", \"hint\":\"How much this item grows to fill available space (0 = don't grow).\"}"
