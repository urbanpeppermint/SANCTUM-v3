    - "@property {Component.ScriptComponent} scriptComponent"
    - "@property {string} functionName"
    - "*/"
    - '// @input Callback[] onValueChangeCallbacks = {} {"label":"On Value Changed Callbacks", "showIf":"addCallbacks"}'
