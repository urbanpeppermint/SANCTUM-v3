    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Flex Properties</span>"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #94A3B8; font-size: 11px;\">Main axis direction, wrapping, and alignment behavior</span>"}'
    - '// @input string _direction = "row" {"label":"Direction", "hint":"Main axis direction for laying out items.", "widget":"combobox", "values":[{"label":"Row", "value":"row"}, {"label":"Row Reverse", "value":"rowReverse"}, {"label":"Column", "value":"column"}, {"label":"Column Reverse", "value":"columnReverse"}]}'
    - '// @input string _wrap = "nowrap" {"label":"Wrap", "hint":"Whether items wrap to new lines when they overflow.", "widget":"combobox", "values":[{"label":"No Wrap", "value":"nowrap"}, {"label":"Wrap", "value":"wrap"}, {"label":"Wrap Reverse", "value":"wrapReverse"}]}'
    - '// @input string _justifyContent = "start" {"label":"Justify Content", "hint":"Distribution of items along the main axis.", "widget":"combobox", "values":[{"label":"Start", "value":"start"}, {"label":"Center", "value":"center"}, {"label":"End", "value":"end"}, {"label":"Space Between", "value":"spaceBetween"}, {"label":"Space Around", "value":"spaceAround"}, {"label":"Space Evenly", "value":"spaceEvenly"}]}'
    - '// @input string _alignItems = "start" {"label":"Align Items", "hint":"Alignment of items along the cross axis.", "widget":"combobox", "values":[{"label":"Start", "value":"start"}, {"label":"Center", "value":"center"}, {"label":"End", "value":"end"}, {"label":"Stretch", "value":"stretch"}]}'
    - '// @input string _alignContent = "start" {"label":"Align Content", "hint":"Distribution of wrapped lines along the cross axis (only applies when wrapping).", "widget":"combobox", "values":[{"label":"Start", "value":"start"}, {"label":"Center", "value":"center"}, {"label":"End", "value":"end"}, {"label":"Space Between", "value":"spaceBetween"}, {"label":"Space Around", "value":"spaceAround"}, {"label":"Space Evenly", "value":"spaceEvenly"}, {"label":"Stretch", "value":"stretch"}]}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Gap</span>"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #94A3B8; font-size: 11px;\">Spacing between rows and columns</span>"}'
    - '// @input float _rowGap {"label":"Row Gap", "hint":"Gap between rows in cm. Always separates horizontal rows of items — cross-axis gap when direction=Row, main-axis gap when direction=Column."}'
    - '// @input float _columnGap {"label":"Column Gap", "hint":"Gap between columns in cm. Always separates vertical columns of items — main-axis gap when direction=Row, cross-axis gap when direction=Column."}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Padding</span>"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #94A3B8; font-size: 11px;\">Inner spacing between container edges and content</span>"}'
    - '// @input float _paddingTop {"label":"Top", "hint":"Top padding in cm."}'
    - '// @input float _paddingRight {"label":"Right", "hint":"Right padding in cm."}'
    - '// @input float _paddingBottom {"label":"Bottom", "hint":"Bottom padding in cm."}'
    - '// @input float _paddingLeft {"label":"Left", "hint":"Left padding in cm."}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Content Alignment</span>"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #94A3B8; font-size: 11px;\">Position of the layout content relative to the SceneObject center</span>"}'
    - '// @input string _horizontalAlignment = "center" {"label":"Horizontal", "hint":"Horizontal alignment of the layout content relative to the SceneObject center.", "widget":"combobox", "values":[{"label":"Left", "value":"left"}, {"label":"Center", "value":"center"}, {"label":"Right", "value":"right"}]}'
    - '// @input string _verticalAlignment = "center" {"label":"Vertical", "hint":"Vertical alignment of the layout content relative to the SceneObject center.", "widget":"combobox", "values":[{"label":"Top", "value":"top"}, {"label":"Center", "value":"center"}, {"label":"Bottom", "value":"bottom"}]}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Item Source</span>"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #94A3B8; font-size: 11px;\">Choose whether this layout manages direct children automatically or uses an explicit manual item list</span>"}'
    - '// @input bool _autoDiscoverItemsOnStart = true {"label":"Auto Discover Items On Start", "hint":"Discovers direct-child FlexItems once during OnStartEvent. Disable to manage items manually"}'
    - '// @ui {"widget":"group_start", "label":"Flex Items Selection", "showIf":"_autoDiscoverItemsOnStart", "showIfValue":false}'
    - '// @input AssignableType_1[] _items = {} {"label":"Items", "hint":"Choose initial flex item children for the layout"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Debug</span>"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #94A3B8; font-size: 11px;\">Visual debugging tools for layout inspection</span>"}'
    - '// @input bool _debug {"label":"Debug Visualization", "hint":"Enable debug visualization (container and item bounds)."}'
