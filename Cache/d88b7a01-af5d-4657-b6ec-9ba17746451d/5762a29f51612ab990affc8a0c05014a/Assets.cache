    - "// @input string _templateRows = \"1fr\" {\"label\":\"Template Rows\", \"hint\":\"Row track definitions. E.g. '1fr', '2cm auto 1fr', 'repeat(2, 1fr)'\"}"
    - "// @input string _autoRows = \"1fr\" {\"label\":\"Auto Rows\", \"hint\":\"Sizing for implicitly created row tracks. E.g. '1fr', 'auto', '2cm'\"}"
