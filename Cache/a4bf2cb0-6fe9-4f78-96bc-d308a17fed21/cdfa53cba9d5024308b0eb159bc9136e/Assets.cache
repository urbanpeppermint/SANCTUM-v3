    - '// @ui {"widget":"group_start", "label":"Inputs"}'
    - '// @input string instructions = "You are a helpful assistant that loves to make puns" {"widget":"text_area"}'
    - // @input bool haveVideoInput
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"Outputs"}'
